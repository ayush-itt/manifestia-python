PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DATABASE_PATH=./storage/manifestia.db
STORAGE_ROOT=./storage

PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
UNSPLASH_ACCESS_KEY=
NASA_API_KEY=

BYTEPLUS_API_KEY=
BYTEPLUS_API_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-260128
PUBLIC_API_URL=http://localhost:4100

# Leave blank to use files inside content/
BACKGROUND_MUSIC_DIR=
STORY_PATH=
STORY_ASSETS_DIR=
STORY_TEMPLATES_DIR=
ONBOARDING_QUESTIONS_PATH=
ONBOARDING_CATALOG_PATH=

VIDEO_RATIO=9:16
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24
SCENE_DURATION_SEC=10
NARRATION_DELAY_SEC=2
TTS_VOICE=en-US-AriaNeural

# --- Render (do not commit a real .env; paste secrets in the dashboard) ---
# Runtime must be Docker (python:3.12-slim-bookworm). Native Python 3.14 cannot
# install pydantic-core and has no ffmpeg.
# Leave PORT unset on Render (injected). PUBLIC_API_URL can stay blank; the
# app uses RENDER_EXTERNAL_URL when the configured URL is localhost.
#
# NODE_ENV=production
# DATABASE_PATH=/var/data/manifestia.db
# STORAGE_ROOT=/var/data/storage
# PUBLIC_API_URL=https://<service>.onrender.com
